<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_prep</name>
  <version>1.0.0</version>
  <description>
    Gazebo Harmonic simulation bridge for the STM32-based self-balancing wheeled
    bipedal robot. Reproduces the physical robot's three-layer cascade PID
    (position -> velocity -> balance), its 5-bar parallel leg linkages, the RC
    teleop mapping and the wireless tuning GUI protocol, so that control gains
    developed in simulation transfer directly to the hardware firmware.
  </description>

  <maintainer email="periyasubala@gmail.com">Sndcooper</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- C++ node (balance_point) -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rcl_interfaces</depend>

  <!-- Python nodes (standing_mode, rc_teleop, wireless_gui_bridge) -->
  <depend>rclpy</depend>

  <!-- Model description / state publishing -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- ros2_control stack -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>

  <!-- Gazebo Harmonic integration -->
  <exec_depend>ign_ros2_control</exec_depend>
  <exec_depend>ros_ign_gazebo</exec_depend>
  <exec_depend>ros_ign_bridge</exec_depend>

  <!-- Launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
