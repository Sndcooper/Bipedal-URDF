  <link name="left_femur_front">
    <inertial>
      <origin rpy="0 0 0" xyz="0.014245 0.014384 -0.006482"/>
      <mass value="0.040000"/>
      <inertia ixx="1.438833e-05" ixy="0.0" ixz="0.0" iyy="1.421687e-05" iyz="0.0" izz="2.756353e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.065 -0.055 0.144"/>
      <geometry>
