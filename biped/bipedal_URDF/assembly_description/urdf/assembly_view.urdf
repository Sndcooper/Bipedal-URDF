    </collision>
  </link>
  <link name="left_shank_rear">
    <inertial>
      <origin rpy="0 0 0" xyz="0.003882 0.003124 0.000416"/>
      <mass value="0.338000"/>
      <inertia ixx="4.490088e-04" ixy="0.0" ixz="0.0" iyy="5.551611e-04" iyz="0.0" izz="7.475011e-04"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.092496 0.052634 0.148"/>
      <geometry>
        <mesh filename="../meshes/left_shank_rear.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="shank_dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.092496 0.052634 0.148"/>
      <geometry>
        <mesh filename="../meshes/left_shank_rear.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="left_shank_front">
    <inertial>
      <origin rpy="0 0 0" xyz="0.042362 -0.046317 0.001668"/>
      <mass value="0.040000"/>
      <inertia ixx="4.724833e-05" ixy="0.0" ixz="0.0" iyy="4.210497e-05" iyz="0.0" izz="8.847163e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.103696 -0.094085 0.148"/>
      <geometry>
        <mesh filename="../meshes/left_shank_front.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="linkage_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.103696 -0.094085 0.148"/>
      <geometry>
        <mesh filename="../meshes/left_shank_front.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_hip_rear" type="revolute">
    <origin rpy="0 0 1.0472841962059805" xyz="0.065 -0.005 -0.144"/>
    <parent link="base_link"/>
    <child link="left_femur_rear"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-1.396263" upper="0.523599" velocity="100"/>
    <dynamics damping="0.05"/>
  </joint>
  <!-- MIMIC CHAIN: driver = left_hip_rear. multiplier -1 makes the two femurs
       counter-rotate, which is the symmetric spread/crouch motion. -->
  <joint name="left_hip_front" type="revolute">
    <origin rpy="0 0 -0.790399343078837" xyz="0.065 0.055 -0.144"/>
    <parent link="base_link"/>
    <child link="left_femur_front"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-0.523599" upper="1.396263" velocity="100"/>
    <dynamics damping="0.05"/>
    <mimic joint="left_hip_rear" multiplier="-1.0" offset="0"/>
  </joint>
  <!-- knee = femur distal pivot. 55.000 mm from the hip, confirmed against
       the bolt-hole ring in the mesh.

       The true knee ratio along this symmetric path is not constant: it runs
       from -1.5400 at t = -20 deg to -1.4416 at t = -80 deg. -1.4774 is the
       MINIMAX fit over the driver range [-80, +30] deg, chosen to bound the
       worst-case foot gap rather than to be exact at the zero pose. Residual
       foot gap: 0.00 mm at zero, under 1.5 mm for |t| < 50 deg, 6.48 mm at the
       -80 deg extreme. -->
  <joint name="left_knee_rear" type="revolute">
    <origin rpy="0 0 -1.442050229164275" xyz="0.027496 -0.047634 -0.004"/>
    <parent link="left_femur_rear"/>
    <child link="left_shank_rear"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-1.047198" upper="2.094395" velocity="100"/>
    <dynamics damping="0.05"/>
    <mimic joint="left_hip_rear" multiplier="-1.477400" offset="0"/>
  </joint>
  <joint name="left_knee_front" type="revolute">
    <origin rpy="0 0 1.337538022687104" xyz="0.038696 0.039085 -0.004"/>
    <parent link="left_femur_front"/>
    <child link="left_shank_front"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-2.094395" upper="1.047198" velocity="100"/>
    <dynamics damping="0.05"/>
    <!-- Mimics hip_FRONT, not hip_rear. Mathematically identical during normal
         driving (hip_front = -1.0*hip_rear, so -1.4774*hip_front = +1.4774*
         hip_rear), but it keeps the FRONT chain self-consistent if a viewer
         lets the user drag left_hip_front directly: the knee then follows its
         own parent hip instead of freezing. Cuts the tear-open error from
         207 mm to 86 mm at the 80 deg extreme. -->
    <mimic joint="left_hip_front" multiplier="-1.477400" offset="0"/>
  </joint>
  <!-- foot frame at the loop-closure pivot, carried by the front shank -->
  <link name="left_foot"/>
  <joint name="left_foot_frame" type="fixed">
    <origin rpy="0 0 0" xyz="0.072552 -0.079325 0.0"/>
    <parent link="left_shank_front"/>
    <child link="left_foot"/>
  </joint>
  <!-- ===================================================================== -->
  <!-- LEFT WHEEL                                                            -->
  <!--                                                                       -->
  <!-- Mounts on the D-shaft protruding from the OUTBOARD face of the        -->
  <!-- motor-carrying rear shank. Shaft located by scanning the STL: axis at -->
  <!-- mesh (182.897, 15.848), body face at Z = -159.0 mm, shaft tip at      -->
  <!-- Z = -175.22 mm, so it stands 16.22 mm proud at ~6 mm radius (with the -->
  <!-- D-flat cutting the minimum radius to 2.72 mm). The joint origin puts  -->
  <!-- the wheel mid-plane 7.5 mm outboard of that face, i.e. the 15 mm-wide -->
  <!-- wheel is centred on the exposed shaft.                                -->
  <!--                                                                       -->
  <!-- Outboard on this leg is -Z, so the axis is negated relative to the    -->
  <!-- right wheel: +rotation is "forward" on both sides.                    -->
  <!--                                                                       -->
  <!-- COLLISION is a SPHERE, not the visual cylinder, so the contact solver -->
  <!-- sees one smooth point instead of catching on a polygonal rim edge.    -->
  <!-- ===================================================================== -->
  <link name="left_wheel">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.030000"/>
      <!-- solid cylinder, axis = local Z: Izz = m*r^2/2, Ixx=Iyy = m*(3r^2+L^2)/12 -->
      <inertia ixx="8.730000e-06" ixy="0.0" ixz="0.0" iyy="8.730000e-06" iyz="0.0" izz="1.633500e-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.015" radius="0.033"/>
      </geometry>
      <material name="shank_dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.033"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.090401 0.068482 -0.018500"/>
    <parent link="left_shank_rear"/>
    <child link="left_wheel"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.01"/>
  </joint>
  <!-- ===================================================================== -->
  <!-- RIGHT LEG  (CAD z = +0.004 / +0.008)                                  -->
  <!-- Here the motor-carrying shank is the FRONT one.                       -->
  <!-- ===================================================================== -->
  <link name="right_femur_rear">
